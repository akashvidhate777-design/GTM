{
  "name": "WF-2 Sequence Engine (LinkedIn + Email, Day 0/3/7)",
  "nodes": [
    {
      "id": "cron-daily",
      "name": "Every day 09:30",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-720, 100],
      "parameters": {
        "rule": { "interval": [{ "field": "cronExpression", "expression": "30 9 * * 1-5" }] }
      }
    },
    {
      "id": "read-sheet",
      "name": "Read leads",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [-480, 100],
      "parameters": {
        "operation": "read",
        "documentId": { "__rl": true, "mode": "id", "value": "={{ $env.GOOGLE_SHEET_ID }}" },
        "sheetName": { "__rl": true, "mode": "name", "value": "Leads" },
        "options": {}
      },
      "credentials": { "googleSheetsOAuth2Api": { "name": "Google Sheets account" } }
    },
    {
      "id": "select-due",
      "name": "Select due leads (cadence + cap)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-240, 100],
      "parameters": {
        "jsCode": "// Cadence: step 1 on Approved (day 0), step 2 three days after step 1,\n// step 3 four days after step 2. Stops on Replied/Bounced/Do Not Contact.\nconst CAP = parseInt($env.DAILY_SEND_CAP || '30', 10);\nconst GAP = { 1: 0, 2: 3, 3: 4 };\nconst today = new Date();\nconst due = [];\nfor (const { json: row } of items) {\n  const status = (row['Status'] || '').trim();\n  const step = parseInt(row['Sequence Step'] || '0', 10);\n  if (['Replied', 'Bounced', 'Do Not Contact'].includes(status)) continue;\n  let nextStep = null;\n  if (status === 'Approved' && step === 0) nextStep = 1;\n  else if (status.startsWith('Sent') && step >= 1 && step <= 2) {\n    const last = new Date(row['Last Touch Date'] || 0);\n    const days = (today - last) / 86400000;\n    if (days >= GAP[step + 1]) nextStep = step + 1;\n  }\n  if (!nextStep) continue;\n  due.push({ json: { ...row,\n    _step: nextStep,\n    _subject: (row[`Email ${nextStep} Subject`] || '').replaceAll('{{SENDER_NAME}}', $env.SENDER_NAME).replaceAll('{{CALENDLY_URL}}', $env.CALENDLY_URL),\n    _body: (row[`Email ${nextStep} Body`] || '').replaceAll('{{SENDER_NAME}}', $env.SENDER_NAME).replaceAll('{{SENDER_EMAIL}}', $env.SENDER_EMAIL).replaceAll('{{CALENDLY_URL}}', $env.CALENDLY_URL),\n    _linkedin: nextStep === 1 ? row['LinkedIn Connection Message'] : row[`LinkedIn Follow-Up ${nextStep - 1}`]\n  } });\n  if (due.length >= CAP) break;\n}\nreturn due;"
      }
    },
    {
      "id": "send-email",
      "name": "Send email step (Gmail)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [0, 0],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.Email }}",
        "subject": "={{ $json._subject }}",
        "emailType": "text",
        "message": "={{ $json._body }}",
        "options": {}
      },
      "credentials": { "gmailOAuth2": { "name": "Gmail account" } }
    },
    {
      "id": "linkedin-assist",
      "name": "Slack: LinkedIn send-assist",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [0, 220],
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": { "__rl": true, "mode": "name", "value": "={{ $env.SLACK_APPROVALS_CHANNEL }}" },
        "text": "=:link: *LinkedIn step {{ $json._step }}* for *{{ $json['First Name'] }} {{ $json['Last Name'] }}* ({{ $json.Title }} @ {{ $json.Company }})\nProfile: {{ $json['Person Linkedin Url'] }}\n\nCopy-paste message:\n```{{ $json._linkedin }}```\n_LinkedIn has no compliant send API — one click, paste, send._",
        "otherOptions": {}
      },
      "credentials": { "slackApi": { "name": "Slack Bot" } }
    },
    {
      "id": "update-row",
      "name": "Update Status / step / dates",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [240, 100],
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": { "__rl": true, "mode": "id", "value": "={{ $env.GOOGLE_SHEET_ID }}" },
        "sheetName": { "__rl": true, "mode": "name", "value": "Leads" },
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": ["Email"],
          "value": {
            "Email": "={{ $json.Email }}",
            "Status": "=Sent - Step {{ $json._step }}",
            "Sequence Step": "={{ $json._step }}",
            "Last Touch Date": "={{ new Date().toISOString().slice(0, 10) }}",
            "Next Action Date": "={{ $json._step < 3 ? new Date(Date.now() + ($json._step === 1 ? 3 : 4) * 86400000).toISOString().slice(0, 10) : '' }}"
          }
        },
        "options": {}
      },
      "credentials": { "googleSheetsOAuth2Api": { "name": "Google Sheets account" } }
    },
    {
      "id": "hubspot-upsert",
      "name": "HubSpot: upsert contact",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2.1,
      "position": [480, 100],
      "parameters": {
        "resource": "contact",
        "operation": "upsert",
        "email": "={{ $json.Email }}",
        "additionalFields": {
          "firstName": "={{ $json['First Name'] }}",
          "lastName": "={{ $json['Last Name'] }}",
          "jobTitle": "={{ $json.Title }}",
          "companyName": "={{ $json.Company }}",
          "customPropertiesUi": {
            "customPropertiesValues": [
              { "property": "lead_score", "value": "={{ $json['Lead Score'] }}" },
              { "property": "lead_grade", "value": "={{ $json['Lead Grade'] }}" },
              { "property": "outreach_status", "value": "=Sent - Step {{ $json._step }}" },
              { "property": "sequence_step", "value": "={{ $json._step }}" }
            ]
          }
        }
      },
      "credentials": { "hubspotApi": { "name": "HubSpot account" } }
    },
    {
      "id": "check-replies",
      "name": "Gmail: check replies",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [-240, 340],
      "parameters": {
        "resource": "message",
        "operation": "getAll",
        "returnAll": false,
        "limit": 50,
        "filters": { "q": "in:inbox newer_than:2d" }
      },
      "credentials": { "gmailOAuth2": { "name": "Gmail account" } }
    },
    {
      "id": "match-replies",
      "name": "Match replies to leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [0, 440],
      "parameters": {
        "jsCode": "// Marks leads Replied when an inbox message matches their address.\nconst leads = $('Read leads').all().map(i => i.json);\nconst byEmail = new Map(leads.filter(l => (l.Status || '').startsWith('Sent')).map(l => [String(l.Email).toLowerCase(), l]));\nconst out = [];\nfor (const { json: msg } of items) {\n  const from = String(msg.from?.value?.[0]?.address || msg.From || '').toLowerCase();\n  const m = from.match(/[\\w.+-]+@[\\w.-]+/);\n  if (m && byEmail.has(m[0])) {\n    out.push({ json: { Email: byEmail.get(m[0]).Email, Status: 'Replied' } });\n    byEmail.delete(m[0]);\n  }\n}\nreturn out;"
      }
    },
    {
      "id": "mark-replied",
      "name": "Set Status = Replied",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [240, 440],
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": { "__rl": true, "mode": "id", "value": "={{ $env.GOOGLE_SHEET_ID }}" },
        "sheetName": { "__rl": true, "mode": "name", "value": "Leads" },
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": ["Email"],
          "value": { "Email": "={{ $json.Email }}", "Status": "Replied" }
        },
        "options": {}
      },
      "credentials": { "googleSheetsOAuth2Api": { "name": "Google Sheets account" } }
    }
  ],
  "connections": {
    "Every day 09:30": { "main": [[{ "node": "Read leads", "type": "main", "index": 0 }]] },
    "Read leads": { "main": [[
      { "node": "Select due leads (cadence + cap)", "type": "main", "index": 0 },
      { "node": "Gmail: check replies", "type": "main", "index": 0 }
    ]] },
    "Select due leads (cadence + cap)": { "main": [[
      { "node": "Send email step (Gmail)", "type": "main", "index": 0 },
      { "node": "Slack: LinkedIn send-assist", "type": "main", "index": 0 }
    ]] },
    "Send email step (Gmail)": { "main": [[{ "node": "Update Status / step / dates", "type": "main", "index": 0 }]] },
    "Update Status / step / dates": { "main": [[{ "node": "HubSpot: upsert contact", "type": "main", "index": 0 }]] },
    "Gmail: check replies": { "main": [[{ "node": "Match replies to leads", "type": "main", "index": 0 }]] },
    "Match replies to leads": { "main": [[{ "node": "Set Status = Replied", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "timezone": "Asia/Kolkata" }
}
